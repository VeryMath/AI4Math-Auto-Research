-TRACE="$LOG/codex-health.jsonl"
-TS="$(date -u +%FT%TZ)"
-
-# --- backend-aware: the chatgpt (login) backend has no API endpoint to ping ---
-# Probe the codex login instead (like doctor/recover), so a healthy ChatGPT login
