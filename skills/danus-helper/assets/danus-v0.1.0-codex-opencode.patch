new file mode 100644
index 0000000..e603c8d
--- /dev/null
+++ b/danus/opencode.py
@@ -0,0 +1,192 @@
+"""Shared OpenCode launcher and JSON-event reader for every Danus agent call.
+
+Danus deliberately delegates provider authentication and model selection to the
+operator's OpenCode installation.  A caller may pin ``provider/model`` through
+an environment variable; an empty model leaves the choice to OpenCode.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import tempfile
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, Dict, Iterable, List, Optional
+
+
+DEFAULT_MODEL = ""
+DEFAULT_EFFORT = "xhigh"
+_REPO_ROOT = Path(__file__).resolve().parent.parent
+
+
+def isolated_directory(prefix: str) -> tempfile.TemporaryDirectory[str]:
+    """Create an isolated OpenCode cwd inside the Danus deployment.
+
+    Attached OpenCode sessions keep the deployment project context when their
+    working directory remains under the repository. Runtime data stays under
+    the gitignored runtime/isolated directory.
+    """
+    runtime = Path(
+        os.environ.get("DANUS_RUNTIME", str(_REPO_ROOT / "runtime"))
+    ).expanduser()
+    parent = runtime / "isolated"
+    parent.mkdir(parents=True, exist_ok=True)
+    return tempfile.TemporaryDirectory(prefix=prefix, dir=parent)
+
+
+def resolve_bin() -> str:
+    """Resolve the OpenCode executable at call time."""
+    override = os.environ.get("DANUS_OPENCODE_BIN")
+    if override:
+        if os.path.isabs(override):
+            return override
+        return shutil.which(override) or override
+    wrapper = _REPO_ROOT / "bin" / "opencode"
+    if wrapper.exists():
+        return str(wrapper)
+    user_install = Path.home() / ".opencode" / "bin" / "opencode"
+    if user_install.exists():
+        return str(user_install)
+    return shutil.which("opencode") or "opencode"
+
+
+def model(*override_env_names: str, default: str = DEFAULT_MODEL) -> str:
+    for name in override_env_names:
+        value = os.environ.get(name)
+        if value:
+            return value
+    return os.environ.get("DANUS_OPENCODE_MODEL") or default
+
+
+def effort(*override_env_names: str, default: str = DEFAULT_EFFORT) -> str:
+    for name in override_env_names:
+        value = os.environ.get(name)
+        if value:
+            return value
+    return os.environ.get("DANUS_OPENCODE_EFFORT") or default
+
+
+def variant(level: str) -> str:
+    """Map a Danus effort name to an OpenCode model variant.
+
+    Model families expose different variant names.  Per-level environment
+    settings make the mapping explicit. ``high`` maps to ``high`` and Danus'
+    ``xhigh`` role maps to OpenCode's ``max`` by default. Setting a value to
+    ``off`` omits ``--variant`` for that level.
+    """
+    key = f"DANUS_OPENCODE_VARIANT_{level.upper()}"
+    default_variant = "max" if level.lower() == "xhigh" else level
+    value = os.environ.get(key, default_variant).strip()
+    return "" if value.lower() in {"off", "none", "default"} else value
+
+
+def subprocess_env(opencode_bin: str) -> Dict[str, str]:
+    env = os.environ.copy()
+    directory = os.path.dirname(opencode_bin)
+    if directory:
+        binary_dir = os.path.dirname(os.path.abspath(opencode_bin))
+        path = env.get("PATH", "")
+        parts = path.split(os.pathsep) if path else []
+        if binary_dir not in parts:
+            env["PATH"] = binary_dir + (os.pathsep + path if path else "")
+    return env
+
+
+def run_cmd(
+    *,
+    cwd: Path | str,
+    selected_model: str = "",
+    selected_effort: str = "",
+    agent: str | None = None,
+    auto: bool = True,
+    attach: str | None = None,
+) -> List[str]:
+    """Build an ``opencode run`` command whose prompt is read from stdin."""
+    attach = attach or os.environ.get("DANUS_OPENCODE_SERVER")
+    cmd = [resolve_bin(), "run", "--format", "json", "--dir", str(cwd)]
+    if auto:
+        cmd.append("--auto")
+    if selected_model:
+        cmd.extend(["--model", selected_model])
+    selected_variant = variant(selected_effort) if selected_effort else ""
+    if selected_variant:
+        cmd.extend(["--variant", selected_variant])
+    if agent:
+        cmd.extend(["--agent", agent])
+    if attach:
+        cmd.extend(["--attach", attach])
+    return cmd
+
+
+@dataclass
+class EventResult:
+    text: str = ""
+    session_id: Optional[str] = None
+    model: Optional[str] = None
+    cost_usd: float = 0.0
+    input_tokens: int = 0
+    output_tokens: int = 0
+    reasoning_tokens: int = 0
+    tool_calls: List[str] = field(default_factory=list)
+    errors: List[str] = field(default_factory=list)
+    finish_reasons: List[str] = field(default_factory=list)
+
+
+def _number(value: Any) -> float:
+    try:
+        return float(value or 0)
+    except (TypeError, ValueError):
+        return 0.0
+
+
+def parse_json_events(lines: Iterable[str]) -> EventResult:
+    """Read OpenCode's line-delimited event stream into one useful result."""
+    result = EventResult()
+    text_parts: List[str] = []
+    seen_text_parts: set[str] = set()
+    for raw in lines:
+        raw = raw.strip()
+        if not raw:
+            continue
+        try:
+            event = json.loads(raw)
+        except json.JSONDecodeError:
+            continue
+        result.session_id = event.get("sessionID") or result.session_id
+        event_type = event.get("type")
+        part = event.get("part") or {}
+        if event_type == "text":
+            part_id = str(part.get("id") or len(text_parts))
+            text = part.get("text")
+            if isinstance(text, str) and part_id not in seen_text_parts:
+                text_parts.append(text)
+                seen_text_parts.add(part_id)
+        elif event_type == "tool_use":
+            name = part.get("tool") or part.get("name")
+            if name:
+                result.tool_calls.append(str(name))
+        elif event_type == "step_finish":
+            reason = part.get("reason")
+            if reason:
+                result.finish_reasons.append(str(reason))
+            result.cost_usd += _number(part.get("cost"))
+            tokens = part.get("tokens") or {}
+            result.input_tokens += int(_number(tokens.get("input")))
+            result.output_tokens += int(_number(tokens.get("output")))
+            result.reasoning_tokens += int(_number(tokens.get("reasoning")))
+            model_id = part.get("modelID") or part.get("model")
+            provider_id = part.get("providerID") or part.get("provider")
+            if model_id:
+                result.model = f"{provider_id}/{model_id}" if provider_id else str(model_id)
+        elif event_type == "error":
+            error = event.get("error")
+            if isinstance(error, dict):
+                message = (error.get("data") or {}).get("message") or error.get("name")
+            else:
+                message = error
+            if message:
+                result.errors.append(str(message))
+    result.text = "\n".join(part for part in text_parts if part).strip()
+    return result
