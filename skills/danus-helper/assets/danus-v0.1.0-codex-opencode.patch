+
+# Classify the shared OpenCode server. Danus sends every worker, verifier,
+# strategy, and authoring session through this one process so concurrent agents
+# share OpenCode's database owner and avoid competing startup migrations.
+danus_opencode_health(){
+  local url="${DANUS_OPENCODE_SERVER%/}/global/health"
+  local pf="$DANUS_RUNTIME/run/opencode.pid"
+  local our_pid resp
+  our_pid="$(cat "$pf" 2>/dev/null || true)"
+  resp="$(curl -s --max-time 5 "$url" 2>/dev/null || true)"
+  if [ -n "$resp" ] && printf '%s' "$resp" | grep -q '"healthy"[[:space:]]*:[[:space:]]*true'; then
+    if [ -n "$our_pid" ] && kill -0 "$our_pid" 2>/dev/null; then
+      echo ours; return 0
+    fi
+    echo foreign; return 3
+  fi
+  if [ -n "$our_pid" ] && kill -0 "$our_pid" 2>/dev/null; then
+    echo down; return 5
+  fi
+  if [ -n "$our_pid" ]; then echo stale; return 4; fi
+  echo down; return 5
+}
