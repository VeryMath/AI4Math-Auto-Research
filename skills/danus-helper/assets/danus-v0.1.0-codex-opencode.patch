-
-echo "{\"ts\":\"$TS\",\"kind\":\"scan\",\"recent_logs_with_api_errors\":$recent_fail}" >> "$TRACE"
-
-# --- report ---
-if [ -n "$PING_OK" ]; then
-  echo "ok   codex API reachable  ($(printf '%s' "$PING" | grep -o '"latency_s":[^,}]*'))"
