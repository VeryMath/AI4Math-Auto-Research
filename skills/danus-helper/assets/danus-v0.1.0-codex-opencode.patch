diff --git a/.opencode/plugins/danus-loop.ts b/.opencode/plugins/danus-loop.ts
new file mode 100644
index 0000000..0b1a0b1
--- /dev/null
+++ b/.opencode/plugins/danus-loop.ts
@@ -0,0 +1,223 @@
+import { tool, type Plugin } from "@opencode-ai/plugin"
+import { mkdir, readFile, rename, writeFile } from "node:fs/promises"
+import path from "node:path"
+
+type LoopJob = {
+  id: string
+  sessionID: string
+  agent: string
+  directory: string
+  prompt: string
+  mode: "fixed" | "adaptive"
+  intervalMs?: number
+  nextAt?: number
+  createdAt: number
+  expiresAt: number
+  pending: boolean
+  awaitingReschedule: boolean
+  fallbackUsed: boolean
+}
+
+const DAY = 24 * 60 * 60 * 1000
+const FALLBACK_MS = 20 * 60 * 1000
+const MAX_JOBS_PER_SESSION = 50
+
+function parseInterval(value: string): number {
+  const match = value.trim().match(/^(\d+(?:\.\d+)?)\s*(m|min|h|hr|d)$/i)
+  if (!match) throw new Error("Use an interval such as 10m, 1h, or 1d.")
+  const amount = Number(match[1])
+  const unit = match[2].toLowerCase()
+  const factor = unit.startsWith("m") ? 60_000 : unit.startsWith("h") ? 3_600_000 : DAY
+  const milliseconds = Math.round(amount * factor)
+  if (milliseconds < 60_000) throw new Error("The minimum interval is 1 minute.")
+  return milliseconds
+}
+
+function newID(): string {
+  return `loop-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 7)}`
+}
+
+export const DanusLoop: Plugin = async ({ client, worktree }) => {
+  const statePath = path.join(worktree, "runtime", "opencode-loops.json")
+  let jobs: LoopJob[] = []
+  let saving = Promise.resolve()
+
+  try {
+    const parsed = JSON.parse(await readFile(statePath, "utf8"))
+    if (Array.isArray(parsed)) jobs = parsed
+  } catch {}
+  jobs = jobs.filter((job) => job.expiresAt > Date.now())
+
+  const save = async () => {
+    saving = saving.then(async () => {
+      await mkdir(path.dirname(statePath), { recursive: true })
+      const temporary = `${statePath}.tmp`
+      await writeFile(temporary, JSON.stringify(jobs, null, 2) + "\n", "utf8")
+      await rename(temporary, statePath)
+    })
+    await saving
+  }
+
+  const removeExpired = async () => {
+    const before = jobs.length
+    jobs = jobs.filter((job) => job.expiresAt > Date.now())
+    if (jobs.length !== before) await save()
+  }
+
+  const dispatch = async (job: LoopJob) => {
+    job.pending = false
+    job.awaitingReschedule = job.mode === "adaptive"
+    if (job.mode === "fixed") job.nextAt = Date.now() + (job.intervalMs ?? 60_000)
+    if (job.mode === "adaptive") job.nextAt = undefined
+    await save()
+    try {
+      await client.session.promptAsync({
+        path: { id: job.sessionID },
+        query: { directory: job.directory },
+        body: {
+          agent: job.agent,
+          parts: [{ type: "text", text: `[Danus scheduled check]\n${job.prompt}` }],
+        },
+        throwOnError: true,
+      })
+    } catch {
+      job.pending = true
+      job.nextAt = Date.now() + 60_000
+      await save()
+    }
+  }
+
+  const onIdle = async (sessionID: string) => {
+    const now = Date.now()
+    const sessionJobs = jobs.filter((job) => job.sessionID === sessionID)
+    for (const job of sessionJobs) {
+      if (job.pending || (job.nextAt !== undefined && job.nextAt <= now)) {
+        await dispatch(job)
+        continue
+      }
+      if (job.mode === "adaptive" && job.awaitingReschedule && job.nextAt === undefined) {
+        if (job.fallbackUsed) {
+          jobs = jobs.filter((candidate) => candidate.id !== job.id)
+        } else {
+          job.nextAt = now + FALLBACK_MS
+          job.awaitingReschedule = false
+          job.fallbackUsed = true
+        }
+        await save()
+      }
+    }
+  }
+
+  const tick = async () => {
+    await removeExpired()
+    const due = jobs.filter((job) => job.nextAt !== undefined && job.nextAt <= Date.now())
+    if (!due.length) return
+    const response = await client.session.status({ query: { directory: worktree } })
+    const statuses = response.data ?? {}
+    for (const job of due) {
+      const status = statuses[job.sessionID]
+      if (!status || status.type === "idle") await dispatch(job)
+      else if (!job.pending) {
+        job.pending = true
+        await save()
+      }
+    }
+  }
+
+  const timer = setInterval(() => void tick().catch(() => undefined), 1000)
+
+  return {
+    dispose: async () => clearInterval(timer),
+    event: async ({ event }) => {
+      if (event.type === "session.idle") await onIdle(event.properties.sessionID)
+      if (event.type === "session.deleted") {
+        const sessionID = event.properties.info.id
+        const before = jobs.length
+        jobs = jobs.filter((job) => job.sessionID !== sessionID)
+        if (jobs.length !== before) await save()
+      }
+    },
+    tool: {
+      danus_loop_create: tool({
+        description: "Schedule a recurring prompt in the current OpenCode session.",
+        args: {
+          interval: tool.schema.string().describe("Interval such as 10m, 1h, or 1d"),
+          prompt: tool.schema.string().describe("Work to perform at each interval"),
+        },
+        async execute(args, context) {
+          await removeExpired()
+          const count = jobs.filter((job) => job.sessionID === context.sessionID).length
+          if (count >= MAX_JOBS_PER_SESSION) throw new Error("This session already has 50 loop jobs.")
+          const intervalMs = parseInterval(args.interval)
+          const job: LoopJob = {
+            id: newID(), sessionID: context.sessionID, agent: context.agent,
+            directory: context.directory, prompt: args.prompt, mode: "fixed",
+            intervalMs, nextAt: Date.now() + intervalMs, createdAt: Date.now(),
+            expiresAt: Date.now() + 7 * DAY, pending: false,
+            awaitingReschedule: false, fallbackUsed: false,
+          }
+          jobs.push(job)
+          await save()
+          return JSON.stringify({ id: job.id, nextAt: new Date(job.nextAt!).toISOString() })
+        },
+      }),
+      danus_loop_list: tool({
+        description: "List scheduled prompts for the current OpenCode session.",
+        args: {},
+        async execute(_args, context) {
+          await removeExpired()
+          return JSON.stringify(jobs.filter((job) => job.sessionID === context.sessionID), null, 2)
+        },
+      }),
+      danus_loop_delete: tool({
+        description: "Delete one loop job or every loop job in the current session.",
+        args: {
+          id: tool.schema.string().optional(),
+          all: tool.schema.boolean().optional(),
+        },
+        async execute(args, context) {
+          const before = jobs.length
+          jobs = jobs.filter((job) => {
+            if (job.sessionID !== context.sessionID) return true
+            if (args.all) return false
+            return job.id !== args.id
+          })
+          await save()
+          return `Removed ${before - jobs.length} loop job(s).`
+        },
+      }),
+      danus_schedule_wakeup: tool({
+        description: "Schedule the next adaptive Danus wakeup, 1 to 60 minutes from now, and bind it to the current OpenCode session.",
+        args: {
+          minutes: tool.schema.number().int().min(1).max(60),
+          prompt: tool.schema.string(),
+        },
+        async execute(args, context) {
+          let job = jobs.find((candidate) => candidate.mode === "adaptive")
+          if (!job) {
+            job = {
+              id: newID(), sessionID: context.sessionID, agent: context.agent,
+              directory: context.directory, prompt: args.prompt, mode: "adaptive",
+              createdAt: Date.now(), expiresAt: Date.now() + 7 * DAY,
+              pending: false, awaitingReschedule: false, fallbackUsed: false,
+            }
+            jobs.push(job)
+          }
+          job.sessionID = context.sessionID
+          job.prompt = args.prompt
+          job.agent = context.agent
+          job.directory = context.directory
+          job.nextAt = Date.now() + args.minutes * 60_000
+          job.pending = false
+          job.awaitingReschedule = false
+          job.fallbackUsed = false
+          job.expiresAt = Date.now() + 7 * DAY
+          await save()
+          return JSON.stringify({ id: job.id, nextAt: new Date(job.nextAt).toISOString() })
+        },
+      }),
+    },
+  }
+}
+
+export default DanusLoop
