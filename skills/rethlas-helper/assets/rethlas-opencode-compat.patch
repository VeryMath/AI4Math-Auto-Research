+++ b/agents/verification/AGENTS.opencode.md
@@ -0,0 +1,35 @@
+# OpenCode Compatibility Instructions
+
+This file supplements `AGENTS.md` only for OpenCode runs. Follow the complete
+verification procedure in `AGENTS.md` and apply the mappings below whenever the
+base instructions use Codex-specific names.
+
+## Isolated run ids
+
+The OpenCode verification API supplies a `run_id` beginning with `opencode_`.
+Use that exact id for every memory and result operation.
+
+## MCP tool names
+
+OpenCode prefixes tools from the `verification_agent` MCP server. Interpret
+the unprefixed tool names in `AGENTS.md` and shared skills as follows:
+
+- `search_arxiv_theorems` -> `verification_agent_search_arxiv_theorems`
+- `memory_init` -> `verification_agent_memory_init`
+- `memory_append` -> `verification_agent_memory_append`
+- `memory_query` -> `verification_agent_memory_query`
+- `validate_verification_output` -> `verification_agent_validate_verification_output`
+- `write_verification_output` -> `verification_agent_write_verification_output`
+
+Always call the prefixed OpenCode tool name when it is available.
+
+## Search terminology
+
+References to "Codex built-in web search" mean OpenCode's `websearch` tool.
+Use `webfetch` to retrieve a known page or paper URL.
+
+## Completion
+
+Do not finish with only a textual verdict. Validate and persist the final JSON
+through `verification_agent_write_verification_output`, exactly as required by
+`AGENTS.md`.
diff --git a/agents/verification/api/server_opencode.py b/agents/verification/api/server_opencode.py
new file mode 100644
index 0000000000000000000000000000000000000000..941edaea6ecc617c82f38f61a6253cad3eef63be
--- /dev/null
+++ b/agents/verification/api/server_opencode.py
@@ -0,0 +1,186 @@
+from __future__ import annotations
+
+import json
+import os
+import shlex
+import subprocess
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Dict, List, Optional
+
+from fastapi import FastAPI, HTTPException
+
+from api import server as shared
+
+
+WORK_DIR = shared.WORK_DIR
+RESULTS_ROOT = shared.RESULTS_ROOT
+OPENCODE_BIN = os.getenv("OPENCODE_BIN", "opencode")
+OPENCODE_MODEL = os.getenv("OPENCODE_VERIFICATION_MODEL", "").strip()
+OPENCODE_VARIANT = os.getenv("OPENCODE_VERIFICATION_VARIANT", "").strip()
+OPENCODE_TIMEOUT_SECONDS = (
+    int(os.getenv("OPENCODE_TIMEOUT_SECONDS", "0")) or None
+)
+VERIFICATION_FILENAMES = shared.VERIFICATION_FILENAMES
+
+
+def _results_dir(run_id: str) -> Path:
+    return RESULTS_ROOT / run_id
+
+
+def _log_path(run_id: str) -> Path:
+    return _results_dir(run_id) / "log.md"
+
+
+def _verification_path(run_id: str) -> Optional[Path]:
+    for filename in VERIFICATION_FILENAMES:
+        path = _results_dir(run_id) / filename
+        if path.exists():
+            return path
+    return None
+
+
+def generate_run_id(statement: str) -> str:
+    timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
+    return f"opencode_{timestamp}_{shared._statement_hash(statement)}"
+
+
+def _allocate_run_id(statement: str) -> str:
+    base = generate_run_id(statement)
+    run_id = base
+    suffix = 1
+    while (RESULTS_ROOT / run_id).exists():
+        suffix += 1
+        run_id = f"{base}_{suffix}"
+    return run_id
+
+
+def build_prompt(run_id: str, statement: str, proof: str) -> str:
+    return (
+        f"Run_id: {run_id}. "
+        f"Statement: {statement}. "
+        f"Proof:\n{proof}\n\n"
+        "Follow AGENTS.md and AGENTS.opencode.md exactly to verify the proof "
+        "for the statement. Persist the final structured verification output."
+    )
+
+
+def build_opencode_command(
+    run_id: str,
+    statement: str,
+    proof: str,
+) -> List[str]:
+    command = [
+        OPENCODE_BIN,
+        "run",
+        "--dir",
+        str(WORK_DIR),
+    ]
+    if OPENCODE_MODEL:
+        command.extend(["--model", OPENCODE_MODEL])
+    if OPENCODE_VARIANT:
+        command.extend(["--variant", OPENCODE_VARIANT])
+    command.extend(["--agent", "verifier"])
+    command.append(build_prompt(run_id=run_id, statement=statement, proof=proof))
+    return command
+
+
+def run_opencode_verification(
+    run_id: str,
+    statement: str,
+    proof: str,
+) -> Dict[str, Any]:
+    results_dir = _results_dir(run_id)
+    results_dir.mkdir(parents=True, exist_ok=True)
+    log_path = _log_path(run_id)
+    command = build_opencode_command(
+        run_id=run_id,
+        statement=statement,
+        proof=proof,
+    )
+    environment = os.environ.copy()
+    environment.setdefault("OPENCODE_ENABLE_EXA", "1")
+
+    started_at = datetime.now(timezone.utc).isoformat()
+    try:
+        with log_path.open("w", encoding="utf-8") as log_handle:
+            log_handle.write(f"started_at_utc: {started_at}\n")
+            log_handle.write(f"command: {shlex.join(command)}\n\n")
+            log_handle.flush()
+
+            completed = subprocess.run(
+                command,
+                cwd=WORK_DIR,
+                env=environment,
+                stdout=log_handle,
+                stderr=subprocess.STDOUT,
+                text=True,
+                timeout=OPENCODE_TIMEOUT_SECONDS,
+                check=False,
+            )
+    except subprocess.TimeoutExpired as exc:
+        raise HTTPException(
+            status_code=504,
+            detail=(
+                f"opencode run timed out after {exc.timeout} seconds. "
+                f"See log at {log_path}"
+            ),
+        ) from exc
+
+    verification_path = _verification_path(run_id)
+    if completed.returncode != 0:
+        raise HTTPException(
+            status_code=500,
+            detail=(
+                f"opencode run failed with exit code {completed.returncode}. "
+                f"See log at {log_path}"
+            ),
+        )
+
+    if verification_path is None:
+        expected_primary = _results_dir(run_id) / VERIFICATION_FILENAMES[0]
+        raise HTTPException(
+            status_code=500,
+            detail=(
+                f"verification output was not found at {expected_primary}. "
+                f"See log at {log_path}"
+            ),
+        )
+
+    try:
+        payload = json.loads(verification_path.read_text(encoding="utf-8"))
+    except json.JSONDecodeError as exc:
+        raise HTTPException(
+            status_code=500,
+            detail=f"verification output at {verification_path} is not valid JSON",
+        ) from exc
+
+    if not isinstance(payload, dict):
+        raise HTTPException(
+            status_code=500,
+            detail=f"verification output at {verification_path} must be a JSON object",
+        )
+
+    return payload
+
+
+app = FastAPI(title="OpenCode Verification Agent API", version="0.1.0")
+
+
+@app.get("/health")
+def health() -> Dict[str, str]:
+    return {
+        "status": "ok",
+        "runtime": "opencode",
+        "model": OPENCODE_MODEL or "opencode-configured-default",
+    }
+
+
+@app.post("/verify")
+def verify(request: shared.VerifyRequest) -> Dict[str, Any]:
+    run_id = _allocate_run_id(request.statement)
+    return run_opencode_verification(
+        run_id=run_id,
+        statement=request.statement,
+        proof=request.proof,
+    )
