index 0000000000000000000000000000000000000000..4b2bcb3ba57df9c53ca8db2f2fb716244dbc322d
--- /dev/null
+++ b/agents/generation/tests/run_example_opencode.sh
@@ -0,0 +1,259 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+PROBLEM_FILE="${PROBLEM_FILE:-data/example.md}"
+MODEL="${OPENCODE_GENERATION_MODEL:-}"
+VARIANT="${OPENCODE_GENERATION_VARIANT:-}"
+MAX_ITERATIONS="${MAX_ITERATIONS:-10}"
+OPENCODE_BIN="${OPENCODE_BIN:-opencode}"
+export OPENCODE_ENABLE_EXA="${OPENCODE_ENABLE_EXA:-1}"
+
+if ! command -v "$OPENCODE_BIN" >/dev/null 2>&1; then
+  echo "OpenCode executable not found: $OPENCODE_BIN" >&2
+  exit 1
+fi
+
+if [[ "$PROBLEM_FILE" = /* ]]; then
+  echo "PROBLEM_FILE must be relative to agents/generation: $PROBLEM_FILE" >&2
+  exit 1
+fi
+
+if [[ "$PROBLEM_FILE" == ".." || "$PROBLEM_FILE" == ../* || "$PROBLEM_FILE" == */.. || "$PROBLEM_FILE" == */../* ]]; then
+  echo "PROBLEM_FILE must not contain '..': $PROBLEM_FILE" >&2
+  exit 1
+fi
+
+if [[ "$PROBLEM_FILE" != data/*.md ]]; then
+  echo "PROBLEM_FILE must point to a markdown file under data/: $PROBLEM_FILE" >&2
+  exit 1
+fi
+
+if [[ ! -f "$ROOT_DIR/$PROBLEM_FILE" ]]; then
+  echo "Problem file not found: $ROOT_DIR/$PROBLEM_FILE" >&2
+  exit 1
+fi
+
+if ! [[ "$MAX_ITERATIONS" =~ ^[0-9]+$ ]] || [[ "$MAX_ITERATIONS" -le 0 ]]; then
+  echo "MAX_ITERATIONS must be a positive integer: $MAX_ITERATIONS" >&2
+  exit 1
+fi
+
+# data/algebra/prob1.md -> algebra/prob1
+problem_rel="${PROBLEM_FILE#data/}"
+problem_rel="${problem_rel%.md}"
+problem_name="$(basename "$PROBLEM_FILE" .md)"
+problem_id="opencode/$problem_rel"
+ref_dir="data/${problem_rel}.refs"
+ref_prompt="Use reference_dir=${ref_dir} if it exists."
+
+prepare_references() {
+  local abs_ref_dir="$ROOT_DIR/$ref_dir"
+  if [[ ! -d "$abs_ref_dir" ]]; then
+    return
+  fi
+
+  local pdf_count=0
+  while IFS= read -r -d '' pdf; do
+    pdf_count=$((pdf_count + 1))
+    if ! command -v pdftotext >/dev/null 2>&1; then
+      echo "WARNING: found PDF references, but pdftotext is not installed; PDFs will be ignored." >&2
+      return
+    fi
+
+    local rel_pdf="${pdf#"$abs_ref_dir"/}"
+    local txt="$abs_ref_dir/.extracted/${rel_pdf%.pdf}.txt"
+    mkdir -p "$(dirname "$txt")"
+    if [[ ! -f "$txt" || "$pdf" -nt "$txt" ]]; then
+      pdftotext -layout "$pdf" "$txt"
+    fi
+  done < <(find "$abs_ref_dir" -type f -iname '*.pdf' -not -path "$abs_ref_dir/.extracted/*" -print0)
+
+  if [[ $pdf_count -gt 0 ]]; then
+    ref_prompt="Use reference_dir=${ref_dir} if it exists. PDF references have been extracted to ${ref_dir}/.extracted; read those extracted .txt files instead of the PDFs."
+  fi
+}
+
+extract_session_id() {
+  local log_file="$1"
+  python3 - "$log_file" <<'PY'
+import json
+import sys
+
+with open(sys.argv[1], encoding="utf-8") as handle:
+    for raw_line in handle:
+        try:
+            event = json.loads(raw_line)
+        except json.JSONDecodeError:
+            continue
+        session_id = event.get("sessionID")
+        if isinstance(session_id, str) and session_id:
+            print(session_id)
+            break
+PY
+}
+
+format_duration() {
+  local total="$1"
+  printf "%02d:%02d:%02d" \
+    $((total / 3600)) $(((total % 3600) / 60)) $((total % 60))
+}
+
+run_opencode_turn() {
+  local agent_name="$1"
+  local prompt="$2"
+  local log_file="$3"
+  local session_id="${4:-}"
+  local -a command=(
+    "$OPENCODE_BIN"
+    run
+    --dir "$ROOT_DIR"
+    --agent "$agent_name"
+    --format json
+  )
+
+  if [[ -n "$MODEL" ]]; then
+    command+=(--model "$MODEL")
+  fi
+  if [[ -n "$VARIANT" ]]; then
+    command+=(--variant "$VARIANT")
+  fi
+  if [[ -n "$session_id" ]]; then
+    command+=(--session "$session_id")
+  fi
+
+  "${command[@]}" "$prompt" >"$log_file" 2>&1
+}
+
+prepare_references
+
+LOG_DIR="${LOG_DIR:-$ROOT_DIR/logs/opencode/$problem_rel/iter}"
+verified_path="$ROOT_DIR/results/$problem_id/blueprint_verified.md"
+mkdir -p "$LOG_DIR"
+
+OPENCODE_VERSION="$("$OPENCODE_BIN" --version 2>/dev/null || echo 'unknown')"
+
+echo "========================================"
+echo " OpenCode:   $OPENCODE_VERSION"
+echo " Model:      ${MODEL:-OpenCode configured default}"
+echo " Variant:    ${VARIANT:-OpenCode configured default}"
+echo " Problem:    $PROBLEM_FILE"
+echo " Problem ID: $problem_id"
+echo " References: $ref_dir"
+echo " Max iters:  $MAX_ITERATIONS"
+echo " Logs:       $LOG_DIR"
+echo " Stop file:  $verified_path"
+echo "========================================"
+echo ""
+
+VERIFY_URL="${VERIFY_URL:-http://127.0.0.1:8091/health}"
+if ! curl -sf "$VERIFY_URL" >/dev/null 2>&1; then
+  echo "WARNING: verification service not reachable at ${VERIFY_URL%%/health*}"
+  echo "         The agent may be unable to produce blueprint_verified.md."
+  echo "         Start api.server_opencode:app first if you need verified proofs."
+  echo ""
+fi
+
+START_EPOCH=$(date +%s)
+
+elapsed_timer() {
+  while true; do
+    sleep 30
+    local now
+    now=$(date +%s)
+    local secs=$((now - START_EPOCH))
+    printf "\r  [elapsed %s] still running..." "$(format_duration "$secs")"
+  done
+}
+
+elapsed_timer &
+TIMER_PID=$!
+
+cleanup_timer() {
+  kill "$TIMER_PID" 2>/dev/null || true
+  wait "$TIMER_PID" 2>/dev/null || true
+}
+trap cleanup_timer EXIT
+
+session_id=""
+
+for ((iter = 0; iter < MAX_ITERATIONS; iter += 1)); do
+  log_file="$LOG_DIR/${problem_name}_iter_${iter}.jsonl"
+
+  if [[ -f "$verified_path" ]]; then
+    echo "Solved problem_id=$problem_id before iter=$iter"
+    break
+  fi
+
+  echo "Starting iter=$iter -> $log_file"
+
+  if [[ "$iter" -eq 0 ]]; then
+    prompt="Follow AGENTS.md and AGENTS.opencode.md exactly to solve the math problem in ${PROBLEM_FILE}. Use problem_id=${problem_id}. ${ref_prompt}"
+
+    if run_opencode_turn "rethlas" "$prompt" "$log_file"; then
+      opencode_rc=0
+    else
+      opencode_rc=$?
+    fi
+
+    if [[ "$opencode_rc" -ne 0 ]]; then
+      echo "opencode exited with code $opencode_rc at iter=$iter (see $log_file for details)" >&2
+      exit "$opencode_rc"
+    fi
+
+    session_id="$(extract_session_id "$log_file")"
+    if [[ -z "$session_id" && ! -f "$verified_path" ]]; then
+      echo "Could not extract OpenCode session id from $log_file" >&2
+      exit 1
+    fi
+  elif ((iter % 2 == 1)); then
+    prompt="Please continue. Retrieval tools are disabled for this turn. Think deeply using local files, shared memory, examples, counterexamples, and independent mathematical reasoning."
+
+    if run_opencode_turn "rethlas-no-search" "$prompt" "$log_file" "$session_id"; then
+      opencode_rc=0
+    else
+      opencode_rc=$?
+    fi
+
+    if [[ "$opencode_rc" -ne 0 ]]; then
+      echo "opencode exited with code $opencode_rc at iter=$iter (see $log_file for details)" >&2
+      exit "$opencode_rc"
+    fi
+  else
+    prompt="Please continue. Retrieval tools are available again, including theorem search, web search, and web fetch. Use them when useful, while continuing deep independent mathematical reasoning."
+
+    if run_opencode_turn "rethlas" "$prompt" "$log_file" "$session_id"; then
+      opencode_rc=0
+    else
+      opencode_rc=$?
+    fi
+
+    if [[ "$opencode_rc" -ne 0 ]]; then
+      echo "opencode exited with code $opencode_rc at iter=$iter (see $log_file for details)" >&2
+      exit "$opencode_rc"
+    fi
+  fi
+
+  echo "Finished problem_id=$problem_id iter=$iter -> $log_file"
+done
+
+cleanup_timer
+trap - EXIT
+
+END_EPOCH=$(date +%s)
+TOTAL=$((END_EPOCH - START_EPOCH))
+printf "\n"
+
+if [[ -f "$verified_path" ]]; then
+  echo "Solved problem_id=$problem_id -> $verified_path"
+  printf "Total time: %s\n" "$(format_duration "$TOTAL")"
+  echo ""
+  echo "To view results in the browser, run:"
+  echo "  ./site/serve.sh"
+  echo "Then open http://localhost:3264"
+  exit 0
+fi
+
+echo "Reached MAX_ITERATIONS=$MAX_ITERATIONS without verified blueprint for problem_id=$problem_id" >&2
+printf "Total time: %s\n" "$(format_duration "$TOTAL")"
+exit 1
