diff --git a/src/archon/agents/opencode.py b/src/archon/agents/opencode.py
new file mode 100644
index 0000000..3c626c4
--- /dev/null
+++ b/src/archon/agents/opencode.py
@@ -0,0 +1,500 @@
+"""OpenCode CLI runner for Archon's harness router."""
+
+from __future__ import annotations
+
+import json
+import os
+import shlex
+import shutil
+import subprocess
+import sys
+import threading
+from datetime import datetime, timezone
+from pathlib import Path
+
+from archon import log
+from archon.agent import RunOutcome, supervise_streamed_run
+from archon.commands.tooling.project_config import HarnessDescriptor
+
+
+_KNOWN_MCP_BUNDLES = frozenset({"lean-lsp"})
+_OPENCODE_BIN_ENV = "ARCHON_OPENCODE_BIN"
+
+
+class UnknownMcpBundleError(ValueError):
+    """An OpenCode harness requested an MCP bundle Archon does not ship."""
+
+
+class LeanLspMcpUnavailableError(RuntimeError):
+    """The bundled lean-lsp MCP server cannot be located."""
+
+
+def _now_iso() -> str:
+    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
+
+
+def _resolve_opencode_bin(
+    descriptor: HarnessDescriptor, env: dict[str, str],
+) -> str:
+    override = descriptor.raw.get("bin")
+    if isinstance(override, str) and override:
+        return str(Path(override).expanduser())
+    inherited = env.get(_OPENCODE_BIN_ENV)
+    if inherited:
+        return inherited
+    return shutil.which("opencode") or "opencode"
+
+
+def _prepend_archon_to_path(env: dict[str, str]) -> None:
+    exe = shutil.which("archon")
+    if exe:
+        bindir = str(Path(exe).resolve().parent)
+        parts = env.get("PATH", "").split(os.pathsep)
+        if bindir not in parts:
+            env["PATH"] = os.pathsep.join([bindir, *filter(None, parts)])
+        env.setdefault("ARCHON_CLI_BIN", str(Path(exe).resolve()))
+    env.setdefault("ARCHON_PYTHON", str(Path(sys.executable).resolve()))
+
+
+def _deep_merge(base: dict, overlay: dict) -> dict:
+    result = dict(base)
+    for key, value in overlay.items():
+        if isinstance(value, dict) and isinstance(result.get(key), dict):
+            result[key] = _deep_merge(result[key], value)
+        else:
+            result[key] = value
+    return result
+
+
+# ``opencode run --format json`` emits one JSON object per line.  Keep the
+# normalizer self-contained so it can be piped through the shared Archon
+# subprocess supervisor just like the Claude and Codex runners.
+_OPENCODE_STREAM_PARSER = r'''
+import datetime
+import json
+import sys
+
+verbose = sys.argv[1] == "1"
+raw_path, jsonl_path, model, last_message_path = sys.argv[2:6]
+raw = open(raw_path, "a") if verbose else None
+out = open(jsonl_path, "a")
+
+def emit(kind, **fields):
+    row = {
+        "ts": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
+        "event": kind,
+        **fields,
+    }
+    out.write(json.dumps(row, ensure_ascii=False) + "\n")
+    out.flush()
+
+session_seen = False
+last_message = ""
+errors = []
+turns = 0
+usage = {"input_tokens": 0, "output_tokens": 0, "cache_read_tokens": 0}
+cost = 0.0
+
+for line in sys.stdin:
+    line = line.strip()
+    if not line:
+        continue
+    if raw:
+        raw.write(line + "\n")
+        raw.flush()
+    try:
+        obj = json.loads(line)
+    except json.JSONDecodeError:
+        continue
+
+    sid = obj.get("sessionID")
+    if sid and not session_seen:
+        emit("session_meta", session_id=sid)
+        session_seen = True
+
+    kind = obj.get("type", "")
+    part = obj.get("part") or {}
+    if kind == "text":
+        text = str(part.get("text") or "")
+        if text:
+            last_message = text
+            emit("text", content=text)
+            print(text, flush=True)
+    elif kind == "reasoning":
+        text = str(part.get("text") or "")
+        if text:
+            emit("thinking", content=text)
+    elif kind == "tool_use":
+        state = part.get("state") or {}
+        tool = str(part.get("tool") or "tool")
+        tool_input = state.get("input") or {}
+        emit("tool_call", tool=tool, input=tool_input)
+        if state.get("status") == "error":
+            content = str(state.get("error") or "tool failed")
+        else:
+            content = state.get("output") or ""
+            if not isinstance(content, str):
+                content = json.dumps(content, ensure_ascii=False)
+        emit("tool_result", tool=tool, content=content)
+    elif kind == "step_finish":
+        turns += 1
+        tokens = part.get("tokens") or {}
+        cache = tokens.get("cache") or {}
+        usage["input_tokens"] += int(tokens.get("input") or 0)
+        usage["output_tokens"] += int(tokens.get("output") or 0)
+        usage["cache_read_tokens"] += int(cache.get("read") or 0)
+        cost += float(part.get("cost") or 0.0)
+    elif kind == "error":
+        err = obj.get("error") or part.get("error") or "OpenCode error"
+        if not isinstance(err, str):
+            err = json.dumps(err, ensure_ascii=False)
+        errors.append(err)
+
+summary = "\n".join(errors) if errors else last_message
+emit(
+    "session_end",
+    summary=summary,
+    usage=usage,
+    num_turns=turns,
+    total_cost_usd=cost,
+    model=model,
+    input_tokens=usage["input_tokens"],
+    output_tokens=usage["output_tokens"],
+    cache_read_input_tokens=usage["cache_read_tokens"],
+)
+if last_message_path and last_message:
+    try:
+        with open(last_message_path, "w") as f:
+            f.write(last_message)
+    except OSError:
+        pass
+out.close()
+if raw:
+    raw.close()
+'''
+
+
+class OpenCodeAgent:
+    """Run one Archon role through ``opencode run``."""
+
+    def __init__(self, *, descriptor: HarnessDescriptor, role: str = "") -> None:
+        self.descriptor = descriptor
+        self.role = role
+        self.model = descriptor.model
+
+    def _extra_args(self) -> list[str]:
+        value = self.descriptor.raw.get("extra_args")
+        if isinstance(value, list):
+            return [str(item) for item in value]
+        if isinstance(value, str) and value.strip():
+            return shlex.split(value)
+        return []
+
+    def build_argv(
+        self,
+        prompt: str,
+        *,
+        cwd: Path,
+        env_source: dict[str, str] | None = None,
+        extra_args: list[str] | None = None,
+        resume_session_id: str | None = None,
+    ) -> list[str]:
+        env = env_source or os.environ
+        argv = [
+            _resolve_opencode_bin(self.descriptor, env),
+            "run",
+            "--format",
+            "json",
+            "--auto",
+            "--dir",
+            str(cwd),
+        ]
+        if resume_session_id:
+            argv += ["--session", resume_session_id]
+        if self.model:
+            argv += ["--model", self.model]
+        agent = self.descriptor.raw.get("agent")
+        if isinstance(agent, str) and agent:
+            argv += ["--agent", agent]
+        variant = self.descriptor.raw.get("variant") or self.descriptor.effort
+        if isinstance(variant, str) and variant:
+            argv += ["--variant", variant]
+        argv += self._extra_args()
+        if extra_args:
+            argv += list(extra_args)
+        argv.append(prompt)
+        return argv
+
+    def build_interactive_argv(
+        self,
+        prompt: str,
+        *,
+        cwd: Path,
+        env_source: dict[str, str] | None = None,
+        extra_args: list[str] | None = None,
+    ) -> list[str]:
+        env = env_source or os.environ
+        argv = [
+            _resolve_opencode_bin(self.descriptor, env),
+            str(cwd),
+            "--auto",
+        ]
+        if self.model:
+            argv += ["--model", self.model]
+        agent = self.descriptor.raw.get("agent")
+        if isinstance(agent, str) and agent:
+            argv += ["--agent", agent]
+        argv += self._extra_args()
+        if extra_args:
+            argv += list(extra_args)
+        argv += ["--prompt", prompt]
+        return argv
+
+    def build_env(
+        self,
+        *,
+        cwd: Path,
+        env_overrides: dict[str, str] | None = None,
+    ) -> dict[str, str]:
+        env = os.environ.copy()
+        if env_overrides:
+            env.update(env_overrides)
+        _prepend_archon_to_path(env)
+        # Do not import global or project Claude Code rules/skills merely
+        # because the user happens to have Claude Code installed.
+        env["OPENCODE_DISABLE_CLAUDE_CODE"] = "1"
+
+        binary = _resolve_opencode_bin(self.descriptor, env)
+        if binary != "opencode":
+            env[_OPENCODE_BIN_ENV] = binary
+
+        from archon.commands.init.utils import data_path
+
+        lean_bundle = Path(data_path("skills/lean4"))
+        scripts = lean_bundle / "lib" / "scripts"
+        if scripts.is_dir():
+            env.setdefault("LEAN4_PLUGIN_ROOT", str(lean_bundle))
+            env.setdefault("LEAN4_SCRIPTS", str(scripts))
+            env.setdefault(
+                "LEAN4_REFS", str(lean_bundle / "skills" / "lean4" / "references"),
+            )
+            env.setdefault("LEAN4_PYTHON_BIN", sys.executable)
+
+        inline: dict = {}
+        raw_inline = env.get("OPENCODE_CONFIG_CONTENT")
+        if raw_inline:
+            try:
+                loaded = json.loads(raw_inline)
+                if isinstance(loaded, dict):
+                    inline = loaded
+            except json.JSONDecodeError:
+                log.warn(
+                    "Ignoring invalid OPENCODE_CONFIG_CONTENT while adding "
+                    "Archon's runtime settings."
+                )
+        if isinstance(inline.get("permission"), str):
+            inline["permission"] = {"*": inline["permission"]}
+
+        overlay: dict = {
+            "permission": {
+                "task": "deny",
+                "question": "deny",
+            }
+        }
+        if self.descriptor.mcp:
+            overlay["mcp"] = self._mcp_config(cwd, env)
+        env["OPENCODE_CONFIG_CONTENT"] = json.dumps(
+            _deep_merge(inline, overlay), separators=(",", ":"),
+        )
+        return env
+
+    def _mcp_config(self, cwd: Path, env: dict[str, str]) -> dict:
+        unknown = set(self.descriptor.mcp) - _KNOWN_MCP_BUNDLES
+        if unknown:
+            raise UnknownMcpBundleError(
+                f"opencode harness {self.descriptor.name!r}: unknown MCP "
+                f"bundle(s): {', '.join(sorted(unknown))}"
+            )
+        if "lean-lsp" not in self.descriptor.mcp:
+            return {}
+
+        from archon.commands.init.utils import data_path
+
+        server_dir = Path(data_path("tools/lean-lsp-mcp"))
+        if not server_dir.is_dir():
+            raise LeanLspMcpUnavailableError(
+                f"OpenCode lean-lsp MCP directory not found: {server_dir}"
+            )
+        raw_uv = self.descriptor.raw.get("uv_bin")
+        uv = (
+            str(Path(raw_uv).expanduser())
+            if isinstance(raw_uv, str) and raw_uv
+            else env.get("ARCHON_UV_BIN") or shutil.which("uv") or "uv"
+        )
+        server_env = {"LEAN_PROJECT_PATH": str(cwd)}
+        if env.get("PATH"):
+            server_env["PATH"] = env["PATH"]
+        return {
+            "archon-lean-lsp": {
+                "type": "local",
+                "command": [
+                    uv,
+                    "run",
+                    "--directory",
+                    str(server_dir),
+                    "lean-lsp-mcp",
+                ],
+                "environment": server_env,
+                "enabled": True,
+                "timeout": 600_000,
+            }
+        }
+
+    def _apply_prompt_variant(self, prompt: str, cwd: Path) -> str:
+        variant = self.descriptor.prompt_variant
+        if not variant:
+            return prompt
+        from archon.agents.codex import resolve_prompt_variant
+
+        tail = resolve_prompt_variant(variant, project_path=cwd)
+        if not tail:
+            log.warn(
+                f"opencode harness prompt variant {variant!r} was not found; "
+                "continuing without it."
+            )
+            return prompt
+        return f"{prompt}\n\n{tail.strip()}\n"
+
+    def run(
+        self,
+        prompt: str,
+        *,
+        cwd: Path,
+        log_base: Path | None = None,
+        verbose_logs: bool = False,
+        extra_args: list[str] | None = None,
+        env_overrides: dict[str, str] | None = None,
+        cancel_event: "threading.Event | None" = None,
+        idle_timeout_s: float | None = 900,
+        max_attempts: int = 3,
+        resume_session_id: str | None = None,
+    ) -> bool:
+        prompt = self._apply_prompt_variant(prompt, cwd)
+        env = self.build_env(cwd=cwd, env_overrides=env_overrides)
+        self._announce()
+        argv = self.build_argv(
+            prompt,
+            cwd=cwd,
+            env_source=env,
+            extra_args=extra_args,
+            resume_session_id=resume_session_id,
+        )
+        if log_base is None:
+            return subprocess.run(argv, cwd=cwd, env=env).returncode == 0
+
+        max_attempts = max(1, max_attempts)
+        for attempt in range(1, max_attempts + 1):
+            outcome = self._run_with_logging(
+                argv,
+                cwd=cwd,
+                env=env,
+                log_base=log_base,
+                verbose_logs=verbose_logs,
+                cancel_event=cancel_event,
+                idle_timeout_s=idle_timeout_s,
+                attempt=attempt,
+            )
+            if outcome is RunOutcome.SUCCESS:
+                return True
+            if outcome in (RunOutcome.CANCELLED, RunOutcome.FAILED):
+                return False
+            if attempt < max_attempts:
+                log.warn(
+                    f"opencode run idle for {idle_timeout_s}s; retrying "
+                    f"({attempt}/{max_attempts})."
+                )
+        return False
+
+    def run_interactive(
+        self,
+        prompt: str,
+        *,
+        cwd: Path,
+        extra_args: list[str] | None = None,
+    ) -> int:
+        prompt = self._apply_prompt_variant(prompt, cwd)
+        env = self.build_env(cwd=cwd)
+        self._announce()
+        argv = self.build_interactive_argv(
+            prompt, cwd=cwd, env_source=env, extra_args=extra_args,
+        )
+        return subprocess.run(argv, cwd=cwd, env=env).returncode
+
+    def _announce(self) -> None:
+        role = f" ({self.role})" if self.role else ""
+        model = self.model or "native default"
+        log.info(f"Agent model: {model} [opencode]{role}")
+
+    def _emit_session_start(self, jsonl: Path, attempt: int) -> None:
+        row: dict[str, object] = {
+            "ts": _now_iso(),
+            "event": "session_start",
+            "model": self.model or "native-default",
+            "runner": "opencode",
+        }
+        if self.role:
+            row["role"] = self.role
+        if attempt > 1:
+            row["attempt"] = attempt
+        jsonl.parent.mkdir(parents=True, exist_ok=True)
+        with jsonl.open("a") as stream:
+            stream.write(json.dumps(row) + "\n")
+
+    def _run_with_logging(
+        self,
+        argv: list[str],
+        *,
+        cwd: Path,
+        env: dict[str, str],
+        log_base: Path,
+        verbose_logs: bool,
+        cancel_event: "threading.Event | None",
+        idle_timeout_s: float | None,
+        attempt: int,
+    ) -> RunOutcome:
+        jsonl = Path(f"{log_base}.jsonl")
+        self._emit_session_start(jsonl, attempt)
+        result = supervise_streamed_run(
+            argv,
+            cwd=cwd,
+            env=env,
+            jsonl_path=jsonl,
+            parser_cmd=[
+                sys.executable,
+                "-u",
+                "-c",
+                _OPENCODE_STREAM_PARSER,
+                "1" if verbose_logs else "0",
+                f"{log_base}.opencode-raw.jsonl",
+                str(jsonl),
+                self.model or "native-default",
+                str(log_base.parent / f"{log_base.name}.last_message.txt"),
+            ],
+            stderr_dest=f"{log_base}.raw.log" if verbose_logs else os.devnull,
+            cancel_event=cancel_event,
+            idle_timeout_s=idle_timeout_s,
+            attempt=attempt,
+            role=self.role,
+        )
+        if result.cancelled:
+            return RunOutcome.CANCELLED
+        if result.idle_timeout_hit:
+            return RunOutcome.IDLE_TIMEOUT
+        return RunOutcome.SUCCESS if result.returncode == 0 else RunOutcome.FAILED
+
+
+__all__ = [
+    "LeanLspMcpUnavailableError",
+    "OpenCodeAgent",
+    "UnknownMcpBundleError",
+]
