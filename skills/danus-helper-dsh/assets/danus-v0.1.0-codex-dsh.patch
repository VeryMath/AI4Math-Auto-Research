+# Danus main-agent services for the DeepSeek Harness Web profile.
+- id: agent-default-model
+  config:
+    provider: !!js process.env.DANUS_DSH_PROVIDER ?? 'deepseek-official'
+    model: !!js process.env.DANUS_DSH_MODEL ?? 'deepseek-v4-flash'
+
+- id: llm-deepseek
+  config:
+    thinking: enabled
+    reasoningEffort: !!js process.env.DANUS_DSH_REASONING_EFFORT ?? 'high'
+
+- insert:
+    - id: time-context
+      name: '@deepseek-ai/dsh-time-context'
+
+    - id: schedule
+      name: '@deepseek-ai/dsh-schedule'
+
+    - id: mcp-danus
+      name: '@deepseek-ai/dsh-mcp-client'
+      config:
+        serverName: danus
+        transport: stdio
+        command: !!js process.env.DANUS_MCP_BIN
+        env:
+          DANUS_ROLE: main
+          DANUS_AUTHOR: main_agent
+          DSH_HOME: !!js process.env.DSH_HOME ?? process.env.HOME + '/.dsh'
+          DANUS_DSH_PROVIDER: !!js process.env.DANUS_DSH_PROVIDER ?? 'deepseek-official'
+          DANUS_DSH_MODEL: !!js process.env.DANUS_DSH_MODEL ?? 'deepseek-v4-flash'
+          DANUS_DSH_EFFORT: !!js process.env.DANUS_DSH_EFFORT ?? 'high'
+        toolCallTimeoutMs: 3600000
+        failOnStartupError: true
+    - id: mcp-write-paper
+      name: '@deepseek-ai/dsh-mcp-client'
+      config:
+        serverName: write-paper
+        transport: stdio
+        command: !!js process.env.DANUS_WRITE_PAPER_MCP_BIN
+        env:
+          DANUS_ROLE: main
+          DANUS_AUTHOR: main_agent
+          DSH_HOME: !!js process.env.DSH_HOME ?? process.env.HOME + '/.dsh'
+          DANUS_DSH_PROVIDER: !!js process.env.DANUS_DSH_PROVIDER ?? 'deepseek-official'
+          DANUS_DSH_MODEL: !!js process.env.DANUS_DSH_MODEL ?? 'deepseek-v4-flash'
+          DANUS_DSH_EFFORT: !!js process.env.DANUS_DSH_EFFORT ?? 'high'
+        toolCallTimeoutMs: 3600000
+        failOnStartupError: true
+
+    - id: mcp-human-summary
+      name: '@deepseek-ai/dsh-mcp-client'
+      config:
+        serverName: human-summary
+        transport: stdio
+        command: !!js process.env.DANUS_HUMAN_SUMMARY_MCP_BIN
+        env:
+          DANUS_ROLE: main
+          DANUS_AUTHOR: main_agent
+          DSH_HOME: !!js process.env.DSH_HOME ?? process.env.HOME + '/.dsh'
+          DANUS_DSH_PROVIDER: !!js process.env.DANUS_DSH_PROVIDER ?? 'deepseek-official'
+          DANUS_DSH_MODEL: !!js process.env.DANUS_DSH_MODEL ?? 'deepseek-v4-flash'
+          DANUS_DSH_EFFORT: !!js process.env.DANUS_DSH_EFFORT ?? 'high'
