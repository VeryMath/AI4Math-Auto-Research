+#!/usr/bin/env bash
+set -euo pipefail
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+. "$HERE/../scripts/env.sh" >/dev/null 2>&1
+
+BIN="${DANUS_DSH_REAL_BIN:-}"
+[ -z "$BIN" ] && [ -x "$DANUS_RUNTIME/dsh/node_modules/.bin/dsh" ] \
+  && BIN="$DANUS_RUNTIME/dsh/node_modules/.bin/dsh"
+[ -z "$BIN" ] && BIN="$(PATH="${PATH#"$HERE:"}" command -v dsh 2>/dev/null || true)"
+[ "$BIN" = "$HERE/dsh" ] && BIN=""
+[ -n "$BIN" ] && [ -x "$BIN" ] || {
+  echo "DeepSeek Harness was not found. Run bash scripts/bootstrap.sh." >&2
+  exit 127
+}
+exec "$BIN" "$@"
