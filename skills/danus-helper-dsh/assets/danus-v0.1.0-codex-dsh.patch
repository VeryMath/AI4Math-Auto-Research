new file mode 100644
index 0000000..10ed918
--- /dev/null
+++ b/danus/dsh.py
@@ -0,0 +1,134 @@
+"""Shared DeepSeek Harness launcher for every Danus model call.
+
+Danus installs a project-local ``dsh`` runtime and runs autonomous roles through
+the official headless profile.  The Web profile remains the human-facing main
+agent.  Provider credentials stay in the user's DeepSeek Harness home.
+"""
+
+from __future__ import annotations
+
+import os
+import shutil
+import tempfile
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Dict, List, Optional, Sequence
+
+
+DEFAULT_PROVIDER = "deepseek-official"
+DEFAULT_MODEL = "deepseek-v4-flash"
+DEFAULT_EFFORT = "high"
+_REPO_ROOT = Path(__file__).resolve().parent.parent
+
+
+def isolated_directory(prefix: str) -> tempfile.TemporaryDirectory[str]:
+    """Create an isolated workspace outside the Danus instruction tree."""
+    configured = os.environ.get("DANUS_ISOLATED_ROOT")
+    if configured:
+        parent = Path(configured).expanduser()
+        parent.mkdir(parents=True, exist_ok=True)
+        return tempfile.TemporaryDirectory(prefix=prefix, dir=parent)
+    return tempfile.TemporaryDirectory(prefix=prefix)
+
+
+def resolve_bin() -> str:
+    """Resolve the DeepSeek Harness executable at call time."""
+    override = os.environ.get("DANUS_DSH_BIN")
+    if override:
+        if os.path.isabs(override):
+            return override
+        return shutil.which(override) or override
+    wrapper = _REPO_ROOT / "bin" / "dsh"
+    if wrapper.exists():
+        return str(wrapper)
+    return shutil.which("dsh") or "dsh"
+
+
+def provider(*override_env_names: str, default: str = DEFAULT_PROVIDER) -> str:
+    for name in override_env_names:
+        value = os.environ.get(name)
+        if value:
+            return value
+    return os.environ.get("DANUS_DSH_PROVIDER") or default
+
+
+def model(*override_env_names: str, default: str = DEFAULT_MODEL) -> str:
+    for name in override_env_names:
+        value = os.environ.get(name)
+        if value:
+            return value
+    return os.environ.get("DANUS_DSH_MODEL") or default
+
+
+def effort(*override_env_names: str, default: str = DEFAULT_EFFORT) -> str:
+    for name in override_env_names:
+        value = os.environ.get(name)
+        if value:
+            return normalize_effort(value)
+    return normalize_effort(os.environ.get("DANUS_DSH_EFFORT") or default)
+
+
+def normalize_effort(level: str) -> str:
+    """Map Danus roles onto DeepSeek Harness' native effort names."""
+    value = level.strip().lower()
+    if value == "xhigh":
+        return "max"
+    if value in {"off", "high", "max"}:
+        return value
+    return "high"
+
+
+def subprocess_env(
+    dsh_bin: str,
+    *,
+    selected_provider: str = "",
+    selected_model: str = "",
+    selected_effort: str = "",
+    permission_mode: str = "danger-full-access",
+) -> Dict[str, str]:
+    env = os.environ.copy()
+    binary_dir = os.path.dirname(os.path.abspath(dsh_bin))
+    path = env.get("PATH", "")
+    parts = path.split(os.pathsep) if path else []
+    if binary_dir and binary_dir not in parts:
+        env["PATH"] = binary_dir + (os.pathsep + path if path else "")
+    env["DANUS_DSH_PROVIDER"] = selected_provider or provider()
+    env["DANUS_DSH_MODEL"] = selected_model or model()
+    env["DANUS_DSH_REASONING_EFFORT"] = normalize_effort(
+        selected_effort or effort()
+    )
+    env["DSH_PERMISSION_MODE"] = permission_mode
+    env.setdefault("DSH_TELEMETRY_DISABLED", "1")
+    return env
+
+
+def run_cmd(
+    *,
+    task: str,
+    patches: Sequence[Path | str] = (),
+) -> List[str]:
+    """Build a one-shot DSH headless command."""
+    cmd = [resolve_bin(), "--profile", "headless"]
+    base_patch = _REPO_ROOT / "config" / "dsh-headless.cordis.yml"
+    if base_patch.exists():
+        cmd.extend(["--patch", str(base_patch)])
+    for patch in patches:
+        cmd.extend(["--patch", str(patch)])
+    cmd.append(task)
+    return cmd
+
+
+@dataclass
+class RunResult:
+    text: str
+    model: Optional[str]
+    errors: List[str]
+
+
+def parse_output(stdout: str, stderr: str = "", *, configured_model: str = "") -> RunResult:
+    errors = [line.strip() for line in stderr.splitlines() if line.strip()]
+    return RunResult(
+        text=stdout.strip(),
+        model=configured_model or model(),
+        errors=errors,
+    )
